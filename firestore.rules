rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read & write access to teams collection for hackathon registrations & submissions
    match /teams/{teamId} {
      allow read, write: if true;
    }
    // Allow read & write access to system_config collection (meal session status, system config)
    match /system_config/{docId} {
      allow read, write: if true;
    }
    // Allow read & write access to all documents across the database
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
